{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["GOPATH", "GOCACHE", "GOMODCACHE", "GOFLAGS", "GOROOT"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bin/**"]
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
