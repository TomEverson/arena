{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "GOPATH",
    "GOCACHE",
    "GOMODCACHE",
    "GOFLAGS",
    "GOROOT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "bin/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/shared/params.json",
        "$TURBO_ROOT$/levels/*.json"
      ]
    },
    "test": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/shared/params.json",
        "$TURBO_ROOT$/levels/*.json",
        "$TURBO_ROOT$/testvectors/**/*.json",
        "$TURBO_ROOT$/shared/scripts/*.mjs",
        "$TURBO_ROOT$/server/internal/game/params_gen.go",
        "$TURBO_ROOT$/protocol/messages.json",
        "$TURBO_ROOT$/protocol/scripts/*.mjs",
        "$TURBO_ROOT$/server/internal/protocol/protocol_gen.go",
        "$TURBO_ROOT$/client/src/net/protocol.gen.ts"
      ]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/shared/params.json",
        "$TURBO_ROOT$/levels/*.json"
      ]
    },
    "dev:lag": {
      "cache": false,
      "persistent": true
    }
  }
}
