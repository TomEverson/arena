# Deploy settings. Copy this file to deploy/.env (git-ignored) and fill it in.
# See spec/docs/deploy.md.

# The droplet, as ssh reaches it (root, or a user who can sudo without a password).
DROPLET=root@203.0.113.10

# The game server's host name: a DNS A record pointing at the droplet's IP address.
# On Cloudflare DNS set it to "DNS only" (grey cloud), not proxied.
# No domain yet? <the IP with dashes>.sslip.io works, e.g. 203-0-113-10.sslip.io
GAME_HOST=game.example.com

# The host names the client is served from, comma-separated, no https://.
# The Worker's own address (arena.<your-subdomain>.workers.dev) and any custom domain you add to it.
SITE_HOSTS=arena.your-subdomain.workers.dev

# The droplet's CPU: amd64 (most droplets) or arm64.
DROPLET_ARCH=amd64
