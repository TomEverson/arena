[Unit]
Description=Arena game server
After=network-online.target caddy.service
Wants=network-online.target

[Service]
User=arena
Group=arena
WorkingDirectory=/opt/arena
# ALLOWED_ORIGINS: the host names the client is served from (written by deploy.sh).
EnvironmentFile=/opt/arena/arena.env
# The game is played over WebTransport (QUIC, UDP port 443), which needs the real certificate of
# the game host. Caddy gets and renews that certificate; systemd hands this service a copy of it
# at start (the files themselves are Caddy's, and private). arena-cert.path restarts the
# service when Caddy renews it.
LoadCredential=cert:/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/{{GAME_HOST}}/{{GAME_HOST}}.crt
LoadCredential=key:/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/{{GAME_HOST}}/{{GAME_HOST}}.key
# TCP 8080 is only for Caddy on this machine (the room API over https, and the WebSocket the
# test tools use). UDP 443 is open to the world: that is where players are.
ExecStart=/opt/arena/arena-server --addr=127.0.0.1:8080 --wt-addr=:443 --wt-cert=%d/cert --wt-key=%d/key --level=/opt/arena/levels/ffa.json --practice-level=/opt/arena/levels/greybox.json --allowed-origins=${ALLOWED_ORIGINS}
Restart=always
RestartSec=2
# Port 443 is a low port: allow binding it, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
