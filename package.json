{
  "name": "arena",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "turbo run dev --ui=stream",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "bots": "echo 'bots: not implemented yet'",
    "gen": "pnpm --filter @arena/shared gen && pnpm --filter @arena/protocol gen",
    "vectors": "pnpm --filter @arena/client vectors",
    "dev:lag": "turbo run dev:lag --ui=stream",
    "netcheck": "pnpm --filter @arena/client netcheck",
    "format": "pnpm --filter @arena/client format",
    "combatcheck": "pnpm --filter @arena/client combatcheck"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
